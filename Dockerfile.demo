# ---------------------------------------------------------------------------
# Nobat — single-container demo image
#
# Unlike the production stack (nginx + php-fpm + worker, see docker-compose.yml)
# this image serves everything in one process so it can run on free PaaS
# platforms like Render: `php artisan serve` with SQLite — zero external
# services, database re-seeded on every boot.
# ---------------------------------------------------------------------------

# ---------- Stage 1: frontend assets ----------
FROM node:22-alpine AS assets

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY resources ./resources
COPY vite.config.ts tailwind.config.js tsconfig.json ./
RUN npm run build

# ---------- Stage 2: php runtime ----------
FROM php:8.3-cli-alpine AS app

# The official image already ships every extension Laravel 13 requires
# (pdo_sqlite, sqlite3, mbstring, openssl, curl, dom, xml, fileinfo,
# ctype, tokenizer, session). No compilation needed: keep the demo
# build fast and bulletproof — only add unzip so composer can extract
# dist packages.
RUN apk add --no-cache unzip

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

ENV COMPOSER_ALLOW_SUPERUSER=1

# artisan serve is single-threaded unless workers are requested
ENV PHP_CLI_SERVER_WORKERS=8

WORKDIR /var/www/html

# Dependencies first for better layer caching
COPY composer.json composer.lock ./
RUN composer install \
        --no-dev \
        --no-scripts \
        --no-autoloader \
        --prefer-dist \
        --no-interaction

# Application code + compiled assets
COPY . .
COPY --from=assets /app/public/build ./public/build

RUN composer dump-autoload --optimize \
    && chown -R www-data:www-data storage bootstrap/cache database

COPY docker/demo-entrypoint.sh /usr/local/bin/demo-entrypoint.sh
RUN chmod +x /usr/local/bin/demo-entrypoint.sh

USER www-data

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/demo-entrypoint.sh"]
