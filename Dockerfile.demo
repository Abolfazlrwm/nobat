# ---------------------------------------------------------------------------
# Nobat — single-container demo image
#
# Serves the app with `php artisan serve` + SQLite — zero external services,
# designed for free PaaS hosts (Render, Railway, Koyeb, ...).
#
# The frontend assets are built by `npm run build` and committed to the
# repository (public/build), so this image needs no node and no compiled
# PHP extensions: the official php:8.4-cli-alpine image already ships every
# extension Laravel 13 requires. This keeps the free-tier build ~1 minute.
# (The production stack in Dockerfile builds assets itself with nginx+fpm.)
# ---------------------------------------------------------------------------

FROM php:8.4-cli-alpine

# unzip lets composer extract dist packages (the zip extension is not
# compiled in this image on purpose)
RUN apk add --no-cache unzip

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

ENV COMPOSER_ALLOW_SUPERUSER=1

# artisan serve is single-threaded unless workers are requested
ENV PHP_CLI_SERVER_WORKERS=8

WORKDIR /var/www/html

# Dependencies first for better layer caching
COPY composer.json composer.lock ./
RUN composer install \
        --no-dev \
        --no-scripts \
        --no-autoloader \
        --prefer-dist \
        --no-interaction

# Application code (public/build is committed to the repository)
COPY . .

RUN composer dump-autoload --optimize \
    && chown -R www-data:www-data storage bootstrap/cache database

COPY docker/demo-entrypoint.sh /usr/local/bin/demo-entrypoint.sh
RUN chmod +x /usr/local/bin/demo-entrypoint.sh

USER www-data

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/demo-entrypoint.sh"]
